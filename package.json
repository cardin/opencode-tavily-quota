{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-tavily-quota",
  "version": "1.2.2",
  "description": "OpenCode 2 TUI plugin that shows remaining Tavily API credits in the sidebar.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json && node scripts/types.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "tsx --test usage.test.ts quota-cache.test.ts quota-process.test.ts refresh.test.ts index.test.ts tui.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "tavily",
    "quota",
    "credits"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardin/opencode-tavily-quota.git"
  },
  "bugs": {
    "url": "https://github.com/cardin/opencode-tavily-quota/issues"
  },
  "homepage": "https://github.com/cardin/opencode-tavily-quota#readme",
  "dependencies": {
    "@opencode/plugin": "^2.2.3",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.16"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/theme": "^2.2.3",
    "@opentui/core": "^0.8.0",
    "@opentui/solid": "^0.8.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "^1.9.18",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
