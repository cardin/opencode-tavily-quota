{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "index.ts",
    "tui.tsx",
    "usage.ts",
    "quota-cache.ts",
    "refresh.ts",
    "usage.test.ts",
    "quota-cache.test.ts",
    "refresh.test.ts",
    "index.test.ts",
    "tui.test.ts"
  ]
}
